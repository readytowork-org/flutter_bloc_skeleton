# Copy to env/dev/fastlane/.env and env/prod/fastlane/.env with real values.
FASTLANE_APP_IDENTIFIER=com.example.yourapp
FASTLANE_USER=you@example.com
FASTLANE_TEAM_ID=YOUR_TEAM_ID
FASTLANE_ITC_TEAM_ID=YOUR_ASC_TEAM_ID
MATCH_GIT_URL=https://github.com/your-org/your-certificates.git
MATCH_STORAGE_MODE=git
MATCH_TYPE=appstore
MATCH_PASSWORD=YOUR_MATCH_ENCRYPTION_PASSWORD
MATCH_GIT_BASIC_AUTHORIZATION=BASE64_USERNAME_COLON_TOKEN
